                    <div class="product-footer">
                        <span class="product-price">3,20 €</span>
                        <span class="product-format">250 g</span>
                    </div>
                </div>
            </article>

            <article class="product-card" data-category="semillas">
                <img src="https://unsplash.com" alt="Sésamo tostado" class="product-img">
                <div class="product-info">
                    <span class="product-tag">Semillas y Granel</span>
                    <h2 class="product-title">Sésamo Tostado Natural</h2>
                    <p class="product-desc">Fuente natural de calcio y hierro. Listo para añadir a ensaladas, panes caseros o cremas.</p>
                    <div class="product-footer">
                        <span class="product-price">2,80 €</span>
                        <span class="product-format">250 g</span>
                    </div>
                </div>
            </article>

