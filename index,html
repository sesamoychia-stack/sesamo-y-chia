<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sésamo y Chía | Catálogo de Alimentación Natural</title>
    <style>
        :root {
            --bg-cream: #F9F7F2;
            --card-white: #FFFFFF;
            --green-primary: #3A5A40;
            --green-dark: #283D2D;
            --green-light: #E6ECE7;
            --earth-accent: #A37A58;
            --text-dark: #2C2C2C;
            --text-muted: #666666;
            --border-color: #E5E0D8;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        }

        body {
            background-color: var(--bg-cream);
            color: var(--text-dark);
            line-height: 1.6;
        }

        /* Cabecera minimalista */
        header {
            background-color: var(--card-white);
            border-bottom: 1px solid var(--border-color);
            padding: 2rem 1rem;
            text-align: center;
        }

        header h1 {
            font-size: 2.2rem;
            color: var(--green-primary);
            letter-spacing: -0.5px;
            margin-bottom: 0.3rem;
        }

        header p.subtitle {
            color: var(--earth-accent);
            font-weight: 500;
            font-size: 1rem;
            text-transform: uppercase;
            letter-spacing: 1.5px;
        }

        header p.address {
            margin-top: 0.6rem;
            font-size: 0.9rem;
            color: var(--text-muted);
        }

        /* Contenedor principal */
        .container {
            max-width: 1100px;
            margin: 0 auto;
            padding: 2rem 1rem;
        }

        /* Buscador y filtros */
        .controls {
            display: flex;
            flex-direction: column;
            gap: 1rem;
            margin-bottom: 2.5rem;
            align-items: center;
        }

        .search-box {
            width: 100%;
            max-width: 450px;
            padding: 0.8rem 1.2rem;
            border: 1px solid var(--border-color);
            border-radius: 30px;
            font-size: 1rem;
            background-color: var(--card-white);
            outline: none;
            transition: border-color 0.2s;
        }

        .search-box:focus {
            border-color: var(--green-primary);
        }

        .filters {
            display: flex;
            flex-wrap: wrap;
            gap: 0.5rem;
            justify-content: center;
        }

        .filter-btn {
            background-color: var(--card-white);
            border: 1px solid var(--border-color);
            color: var(--text-dark);
            padding: 0.5rem 1.1rem;
            border-radius: 20px;
            cursor: pointer;
            font-size: 0.9rem;
            transition: all 0.2s;
        }

        .filter-btn:hover {
            border-color: var(--green-primary);
        }

        .filter-btn.active {
            background-color: var(--green-primary);
            color: white;
            border-color: var(--green-primary);
        }

        /* Rejilla del catálogo */
        .catalog-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
            gap: 1.5rem;
        }

        .product-card {
            background-color: var(--card-white);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            transition: transform 0.2s, box-shadow 0.2s;
        }

        .product-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.05);
        }

        .product-img {
            width: 100%;
            height: 190px;
            object-fit: cover;
            background-color: var(--green-light);
        }

        .product-info {
            padding: 1.2rem;
            display: flex;
            flex-direction: column;
            flex-grow: 1;
        }

        .product-tag {
            font-size: 0.75rem;
            font-weight: 600;
            text-transform: uppercase;
            color: var(--green-primary);
            background-color: var(--green-light);
            padding: 0.2rem 0.6rem;
            border-radius: 4px;
            align-self: flex-start;
            margin-bottom: 0.6rem;
        }

        .product-title {
            font-size: 1.15rem;
            font-weight: 600;
            margin-bottom: 0.4rem;
            color: var(--text-dark);
        }

        .product-desc {
            font-size: 0.9rem;
            color: var(--text-muted);
            margin-bottom: 1.2rem;
            flex-grow: 1;
        }

        .product-footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-top: 1px solid var(--border-color);
            padding-top: 0.8rem;
        }

        .product-price {
            font-size: 1.1rem;
            font-weight: 700;
            color: var(--green-dark);
        }

        .product-format {
            font-size: 0.8rem;
            color: var(--text-muted);
        }

        .empty-state {
            text-align: center;
            grid-column: 1 / -1;
            padding: 3rem;
            color: var(--text-muted);
            display: none;
        }

        /* Pie de página discreto */
        footer {
            text-align: center;
            padding: 2rem 1rem;
            margin-top: 3rem;
            border-top: 1px solid var(--border-color);
            font-size: 0.9rem;
            color: var(--text-muted);
        }
    </style>
</head>
<body>

    <header>
        <h1>Sésamo y Chía</h1>
        <p class="subtitle">Alimentación Natural &amp; Granel</p>
        <p class="address">📍 Calle Zafiro 4, Zaragoza</p>
    </header>

    <main class="container">
